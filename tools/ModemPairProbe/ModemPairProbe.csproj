<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OscarWatch/OscarWatch.csproj" />
    <ProjectReference Include="../../OscarWatch.PortAudioProbe/OscarWatch.PortAudioProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyAudioInitializer" AfterTargets="Build">
    <ItemGroup>
      <_AudioProbe Include="../../OscarWatch.PortAudioProbe/bin/$(Configuration)/net10.0/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AudioProbe)" DestinationFiles="@(_AudioProbe->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
