<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OscarWatch.Controls"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:vm="using:OscarWatch.ViewModels"
        x:Class="OscarWatch.Views.Oq4Window"
        Title="OscarWatch OQ4 — Experimental"
        Width="900" Height="720" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.ft4-panel">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtlePanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBlock.ft4-meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ft4-mono">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ft4-status-label">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.ft4-slot">
      <Setter Property="Height" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Foreground" Value="#3D9E6F" />
    </Style>
    <Style Selector="ProgressBar.ft4-slot.tx"><Setter Property="Foreground" Value="#C44B4B" /></Style>
    <Style Selector="TextBlock.ft4-slot-rx"><Setter Property="Foreground" Value="#3D9E6F" /></Style>
    <Style Selector="TextBlock.ft4-slot-tx"><Setter Property="Foreground" Value="#C44B4B" /></Style>
    <Style Selector="Border.ft4-station-warning">
      <Setter Property="Background" Value="#F0121008" />
      <Setter Property="BorderBrush" Value="#FFB300" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Height="200">
      <controls:Ft4WaterfallControl x:Name="Waterfall" StatusText="Audio input not started" />
      <Border x:Name="StationBanner" Classes="ft4-station-warning" Margin="24,28"
              HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock Text="Station details needed" Foreground="#FFD56A" FontSize="16"
                     FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Enter your callsign and grid to operate OQ4."
                     Foreground="#F4F1EA" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Content="Enter station details" Classes="dialog-footer accent"
                  HorizontalAlignment="Center" MinWidth="180" Click="OnEnterStationDetailsClick" />
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Margin="10">
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock x:Name="SlotLabel" Grid.Column="0" Text="RX" FontWeight="SemiBold"
                       MinWidth="28" VerticalAlignment="Center" Classes="ft4-slot-rx" />
            <ProgressBar x:Name="SlotProgress" Grid.Column="1" Classes="ft4-slot" Minimum="0" Maximum="100" />
            <TextBlock x:Name="SlotTime" Grid.Column="2" Classes="ft4-mono" MinWidth="52" HorizontalAlignment="Right" Text="0.00 / 3.75" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="UTC" Classes="ft4-status-label" />
              <TextBlock x:Name="ClockText" Text="--:--:--" Classes="ft4-mono" FontWeight="SemiBold" />
              <TextBlock x:Name="ClockSource" Text="System" Classes="ft4-status-label" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="UL" Classes="ft4-status-label" />
              <TextBlock x:Name="UplinkText" Text="-" Classes="ft4-mono" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="DL" Classes="ft4-status-label" />
              <TextBlock x:Name="DownlinkText" Text="-" Classes="ft4-mono" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting audio input…" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock x:Name="ManualPttPrompt" Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
      <Grid RowDefinitions="*,Auto" RowSpacing="8">
        <Border Grid.Row="0" Classes="ft4-panel" Padding="8">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{loc:Localize Key=Ft4.Decodes}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Localize Key=Ft4.ClearDecodes}" Click="OnClearClick" MinWidth="90" />
                <Button Content="{loc:Localize Key=Ft4.SaveActivity}" Click="OnSaveActivityClick" MinWidth="110" />
                <Button Content="{loc:Localize Key=Ft4.OpenSettings}" Click="OnSettingsClick" MinWidth="96" />
              </StackPanel>
            </DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="100,48,48,72,*,52" ColumnSpacing="10" Margin="4,0,4,6">
              <TextBlock Grid.Column="0" Text="{loc:Localize Key=Ft4.Decodes.Time}" Classes="ft4-meta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{loc:Localize Key=Ft4.Decodes.Kind}" Classes="ft4-meta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{loc:Localize Key=Ft4.Decodes.Dt}" Classes="ft4-meta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="{loc:Localize Key=Ft4.Decodes.Snr}" Classes="ft4-meta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="{loc:Localize Key=Ft4.Decodes.Message}" Classes="ft4-meta" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="{loc:Localize Key=Ft4.Decodes.Hz}" Classes="ft4-meta" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <ListBox x:Name="ActivityList" FontFamily="Consolas,Courier New,monospace" Padding="0">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ContextMenu>
                <ContextMenu Closed="OnDecodeContextClosed">
                  <MenuItem Header="{loc:Localize Key=Ft4.Pounce.OnStation}" Click="OnPounceStationClick" />
                  <MenuItem Header="Prepare audio for loopback" Click="OnPrepareAudioClick" />
                  <MenuItem Header="Send audio-only test" Click="OnLoopbackClick" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:Ft4DecodeRowViewModel">
                <Grid ColumnDefinitions="100,48,48,72,*,52" ColumnSpacing="10" Margin="4,2"
                      Background="{Binding RowBackground}" PointerPressed="OnDecodeRowPointerPressed">
                  <Grid.Styles>
                    <Style Selector="TextBlock.ft4-ink">
                      <Setter Property="Foreground" Value="{Binding RowForeground}" />
                    </Style>
                  </Grid.Styles>
                  <TextBlock Grid.Column="0"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{Binding Message.SlotUtc, StringFormat={}{0:HH:mm:ss}}" />
                  <TextBlock Grid.Column="1"
                             Text="{loc:Localize Key=Ft4.Decodes.Tx}"
                             FontWeight="SemiBold"
                             Foreground="{Binding TxForeground}"
                             IsVisible="{Binding Message.IsTransmitted}" />
                  <TextBlock Grid.Column="1"
                             Text="{loc:Localize Key=Ft4.Decodes.Echo}"
                             FontWeight="SemiBold"
                             Foreground="#6DB3F2"
                             IsVisible="{Binding Message.IsOwnEcho}" />
                  <TextBlock Grid.Column="1"
                             Text="{loc:Localize Key=Ft4.Decodes.Ap}"
                             FontWeight="SemiBold"
                             Foreground="#E0A84A"
                             IsVisible="{Binding Message.IsAcceptedApriori}" />
                  <TextBlock Grid.Column="1"
                             Text="{loc:Localize Key=Ft4.Decodes.Ap}"
                             FontWeight="SemiBold"
                             Foreground="#E0A84A"
                             TextDecorations="Strikethrough"
                             ToolTip.Tip="{loc:Localize Key=Ft4.Decodes.ApRejected.Tip}"
                             AutomationProperties.Name="{loc:Localize Key=Ft4.Decodes.ApRejected.Tip}"
                             IsVisible="{Binding Message.IsRejectedApriori}" />
                  <TextBlock Grid.Column="1"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{loc:Localize Key=Ft4.Decodes.Pounce}"
                             FontWeight="SemiBold"
                             ToolTip.Tip="{loc:Localize Key=Ft4.Decodes.Pounce.Tip}"
                             AutomationProperties.Name="{loc:Localize Key=Ft4.Decodes.Pounce.Tip}"
                             IsVisible="{Binding IsPounceTarget}" />
                  <TextBlock Grid.Column="2"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{Binding DtText}"
                             IsVisible="{Binding Message.IsReceiveActivity}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding DtText}"
                             Foreground="#6DB3F2"
                             IsVisible="{Binding Message.IsOwnEcho}" />
                  <TextBlock Grid.Column="2"
                             Text="-"
                             Opacity="0.45"
                             IsVisible="{Binding Message.IsTransmitted}" />
                  <TextBlock Grid.Column="3"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{Binding Message.SnrDb, StringFormat={}~{0:+0;-0;0} dB}"
                             ToolTip.Tip="Estimated OQ4 data SNR in 2500 Hz. Reference tones are excluded."
                             IsVisible="{Binding Message.IsReceiveActivity}" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding Message.SnrDb, StringFormat={}~{0:+0;-0;0} dB}"
                             ToolTip.Tip="Estimated OQ4 data SNR in 2500 Hz. Reference tones are excluded."
                             Foreground="#6DB3F2"
                             IsVisible="{Binding Message.IsOwnEcho}" />
                  <TextBlock Grid.Column="3"
                             Text="-"
                             Opacity="0.45"
                             IsVisible="{Binding Message.IsTransmitted}" />
                  <TextBlock Grid.Column="4"
                             Text="{Binding Message.Text}"
                             FontWeight="SemiBold"
                             IsVisible="{Binding Message.IsTransmitted}"
                             Foreground="{Binding TxForeground}" />
                  <TextBlock Grid.Column="4"
                             Text="{Binding Message.Text}"
                             FontWeight="SemiBold"
                             IsVisible="{Binding Message.IsOwnEcho}"
                             Foreground="#6DB3F2" />
                  <TextBlock Grid.Column="4"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{Binding Message.Text}"
                             IsVisible="{Binding Message.IsReceiveActivity}" />
                  <TextBlock Grid.Column="5"
                             Classes.ft4-ink="{Binding HasRowForeground}"
                             Text="{Binding Message.FreqHz, StringFormat={}{0:0}}"
                             Opacity="0.9"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Classes="ft4-panel" Padding="10">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="{loc:Localize Key=Ft4.TxMessage}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBox x:Name="MessageBox" Grid.Column="1" FontFamily="Consolas,Courier New,monospace" Watermark="Enter an OQ4 message" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SendButton" Content="{loc:Localize Key=Ft4.EnableTx}" Click="OnSendClick" MinWidth="100" />
              <Button x:Name="StopButton" Content="{loc:Localize Key=Ft4.HaltTx}" Click="OnStopClick" MinWidth="100" IsEnabled="False" />
              <Button x:Name="TuneButton" Content="{loc:Localize Key=Ft4.Tune}" Click="OnTuneClick" MinWidth="88" />
              <Button Content="{loc:Localize Key=Ft4.CallCq}" Click="OnCqClick" MinWidth="100" />
              <Button x:Name="ReportButton" Content="{loc:Localize Key=Ft4.SendReport}" MinWidth="100" IsEnabled="False" Click="OnReportClick" />
              <Button x:Name="Send73Button" Content="{loc:Localize Key=Ft4.Send73}" MinWidth="72" IsEnabled="False" Click="On73Click" />
              <Button x:Name="ManualLogButton" Content="{loc:Localize Key=Ft4.ManualLog}" Click="OnLogbookClick" MinWidth="100" IsEnabled="False" />
              <CheckBox x:Name="SkipRrr" Content="{loc:Localize Key=Ft4.SkipRrr}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <CheckBox x:Name="EvenSlot" Content="{loc:Localize Key=Ft4.PreferEvenSlot}" IsChecked="True" VerticalAlignment="Center" />
                <CheckBox x:Name="HoldTx" Content="{loc:Localize Key=Ft4.HoldTxFrequency}" VerticalAlignment="Center" />
                <CheckBox x:Name="AutoReply" Content="{loc:Localize Key=Ft4.AutoReply}" VerticalAlignment="Center" />
                <CheckBox x:Name="Pounce" Content="{loc:Localize Key=Ft4.Pounce}" Click="OnPounceClick" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=Ft4.TxAudioHz}" VerticalAlignment="Center" />
                <NumericUpDown x:Name="TxFrequency" Minimum="200" Maximum="3000" Increment="10" FormatString="0" MinWidth="128" Width="128" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>
  </DockPanel>
</Window>
